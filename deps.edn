{:paths   ["src/clj" "resources"]
 :deps    {org.clojure/clojure                   {:mvn/version "1.12.3"}
           ;; Sync clients only (default Apache HTTP client). The async Netty
           ;; client is excluded: unused here, and the usual source of
           ;; transitive CVE findings in AWS SDK consumers.
           software.amazon.awssdk/secretsmanager {:mvn/version "2.40.6"
                                                  :exclusions  [software.amazon.awssdk/netty-nio-client]}
           software.amazon.awssdk/ssm            {:mvn/version "2.40.6"
                                                  :exclusions  [software.amazon.awssdk/netty-nio-client]}}
 :aliases {:test       {:extra-deps  {speclj/speclj {:mvn/version "3.13.0"}}
                        :extra-paths ["spec/clj"]}
           :spec       {:main-opts ["-m" "speclj.main" "-c" "-t" "~slow"]}
           :spec-ci    {:main-opts ["-m" "speclj.main" "-c"]}
           :clj-watson {:replace-deps {io.github.clj-holmes/clj-watson {:git/tag "v6.1.0"
                                                                        :git/sha "be98e4db74fb8927db4825cc73bbe2606e44e5e3"}}
                        :main-opts    ["-m" "clj-watson.cli"]}
           :build      {:extra-deps {io.github.cleancoders/github-actions
                                     {:git/sha "7a69c83b05002efce96652493a84513c68f30260" :deps/root "clj"}}
                        :ns-default cleancoders.build.api
                        :exec-args  {:group        "com.cleancoders.c3kit"
                                     :lib-name     "secrets"
                                     :version-file "resources/c3kit/secrets/VERSION"
                                     :repo         "cleancoders/c3kit-secrets"
                                     :ci-workflow  "ci.yml"
                                     :license-url  "https://github.com/cleancoders/c3kit-secrets/blob/master/LICENSE"
                                     :sbom         true}}
           :antq       {:deps      {com.github.liquidz/antq {:mvn/version "2.11.1276"}}
                        :main-opts ["-m" "antq.core"]}}}
